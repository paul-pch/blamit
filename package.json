{
  "name": "blamit",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.1",
  "publisher": "paul-pch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paul-pch/blamit"
  },
  "icon": "images/icon.png",
  "keywords": [
    "git",
    "blame",
    "gitlab",
    "github",
    "gitea",
    "merge request",
    "pull request"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "blamit.openCommit",
        "title": "%command.openCommit%",
        "category": "Blamit"
      },
      {
        "command": "blamit.openMergeRequest",
        "title": "%command.openMergeRequest%",
        "category": "Blamit"
      },
      {
        "command": "blamit.copySha",
        "title": "%command.copySha%",
        "category": "Blamit"
      },
      {
        "command": "blamit.setToken",
        "title": "%command.setToken%",
        "category": "Blamit"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "blamit.openCommit",
          "when": "resourceScheme == file",
          "group": "blamit@1"
        },
        {
          "command": "blamit.openMergeRequest",
          "when": "resourceScheme == file",
          "group": "blamit@2"
        },
        {
          "command": "blamit.copySha",
          "when": "resourceScheme == file",
          "group": "blamit@3"
        }
      ]
    },
    "configuration": {
      "title": "Blamit",
      "properties": {
        "blamit.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%"
        },
        "blamit.remote": {
          "type": "string",
          "default": "origin",
          "description": "%config.remote%"
        },
        "blamit.hosts": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "github",
                  "gitlab",
                  "gitea"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "github",
                      "gitlab",
                      "gitea"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://"
                  }
                },
                "required": [
                  "type"
                ]
              }
            ]
          },
          "markdownDescription": "%config.hosts%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test test/*.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.1.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.4.0"
  }
}
